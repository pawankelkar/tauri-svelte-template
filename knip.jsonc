{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // The only entry knip cannot infer: the Quick Pane is a second Vite entry,
  // a separate webview with its own Svelte context. src/main.ts is reached
  // from index.html, and the vite/vitest/svelte/eslint configs are found by
  // knip's own plugins.
  "entry": ["src/quick-pane-main.ts"],
  "project": ["src/**/*.{ts,svelte}"],

  // Vendored shadcn-svelte output. Its barrels re-export far more than this
  // app consumes, by design, so every unread primitive would be a finding.
  "ignore": ["src/lib/components/ui/**"],

  "ignoreDependencies": [
    // Imported from src/app.css, which knip does not parse.
    "tw-animate-css",
    // bits-ui's own .d.ts files import csstype without declaring it, so it
    // has to stay a direct dependency or type resolution for every bits-ui
    // import breaks under pnpm's strict layout.
    "csstype",
  ],

  // Exports tagged @public are deliberate API surface for template consumers
  // rather than dead code — see src/lib/context-menu.ts.
  "tags": ["-@public"],

  "ignoreExportsUsedInFile": true,
}
