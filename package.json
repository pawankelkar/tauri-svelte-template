{
  "name": "ostralith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "ast-grep": "ast-grep scan",
    "knip": "knip",
    "jscpd": "jscpd",
    "test": "vitest",
    "test:run": "vitest run",
    "rust:test": "cd src-tauri && cargo test --workspace",
    "rust:fmt": "cd src-tauri && cargo fmt --all -- --check",
    "rust:clippy": "cd src-tauri && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust:bindings": "cd src-tauri && cargo test export_bindings -- --ignored --nocapture",
    "check:all": "pnpm format:check && pnpm lint && pnpm check && pnpm ast-grep && pnpm knip && pnpm jscpd && pnpm test:run && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test",
    "release": "node scripts/prepare-release.js",
    "build:sidecars": "node scripts/build-sidecars.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "i18next": "^25.7.3",
    "paneforge": "^1.0.2",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.1.1",
    "csstype": "^3.2.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "jscpd": "^5.0.12",
    "jsdom": "^29.0.1",
    "knip": "^6.27.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
