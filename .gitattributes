# Normalise every text file to LF in the repository and in the working tree.
#
# Without this, a Windows checkout with `core.autocrlf=true` gets CRLF on disk
# while the blobs stay LF, and Prettier's default `endOfLine: "lf"` then fails
# `--check` locally while passing in CI. Pinning `eol=lf` overrides autocrlf,
# so both agree.
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary

pnpm-lock.yaml       -diff linguist-generated=true
src-tauri/Cargo.lock -diff linguist-generated=true

# Generated by tauri-specta — never hand-edited.
src/lib/bindings.ts  linguist-generated=true
